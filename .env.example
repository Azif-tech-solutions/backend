# Copy to .env (git-ignored) and fill in. Never commit .env.
# docker compose reads it for compose.yaml; ./gradlew bootRun reads it through application.yml.
# Generate secrets with: openssl rand -base64 48

# ---- Postgres container (superuser; used only to initialise the database) ----
POSTGRES_DB=zifiq
POSTGRES_USER=zifiq_admin
POSTGRES_PASSWORD=change-me
# Host port Postgres is published on (bound to 127.0.0.1 only).
POSTGRES_PORT=5434

# ---- The role the application connects as (non-superuser, so row-level security applies) ----
APP_DB_USER=zifiq_app
APP_DB_PASSWORD=change-me

# ---- Application (bootRun on your machine; compose sets DATABASE_* itself from the values above) ----
DATABASE_URL=jdbc:postgresql://localhost:5434/zifiq
DATABASE_USERNAME=zifiq_app
DATABASE_PASSWORD=change-me

# At least 32 bytes. Changing it logs everyone out.
JWT_SECRET=change-me-to-the-output-of-openssl-rand-base64-48

# Comma-separated browser origins allowed to call the API, e.g.
# http://localhost:*,http://127.0.0.1:* for local dev, plus exact deployed origins such as https://app.example.com
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# ---- File storage (S3). Leave the bucket empty to run without uploads. ----
ZIFIQ_STORAGE_BUCKET=
ZIFIQ_STORAGE_REGION=
ZIFIQ_STORAGE_KEY_PREFIX=
# Only for an S3-compatible server such as S3Mock (http://localhost:9090); empty for AWS.
ZIFIQ_STORAGE_ENDPOINT=

# ---- Server only: written by the deploy, don't set by hand ----
# ZIFIQ_IMAGE=ghcr.io/azif-tech-solutions/backend:<commit sha>
